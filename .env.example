# All optional; defaults shown.

# Where the manifest database and the raw page store live.
#DATA_DIR=./data
#RAW_DIR=./raw

# Seconds between request starts, per site, and how many requests may be in flight.
#BAYAZ_REQUEST_DELAY=0.35
#BAYAZ_CONCURRENCY=3

#BAYAZ_TIMEOUT=30
#BAYAZ_MAX_ATTEMPTS=3

# Identify yourself to the sites instead of the default browser string.
#BAYAZ_USER_AGENT=
